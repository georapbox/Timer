{
  "name": "@georapbox/timer",
  "version": "3.0.0",
  "description": "A lightweight, drift-free timer library built for the browser — precise, pause-resumable, and easy to use.",
  "main": "dist/timer.js",
  "module": "dist/timer.js",
  "unpkg": "dist/timer.js",
  "type": "module",
  "types": "dist/timer.d.ts",
  "files": [
    "src/",
    "dist/"
  ],
  "scripts": {
    "lint": "eslint",
    "format": "prettier --ignore-unknown --write .",
    "test": "web-test-runner",
    "test:watch": "npm run test -- --watch",
    "test:coverage": "npm run test -- --coverage",
    "types": "tsc --project tsconfig.json",
    "dev:esbuild": "node ./scripts/dev.mjs",
    "dev": "npm-run-all clean dev:esbuild",
    "serve:dev": "web-dev-server --node-resolve --open /docs/ --watch",
    "start": "npm-run-all --parallel \"serve:dev -- {1}\" dev",
    "build:esbuild": "node ./scripts/build.mjs",
    "build": "npm-run-all clean build:esbuild",
    "clean": "rimraf dist",
    "prepare": "npm-run-all clean lint test build types"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/georapbox/Timer.git"
  },
  "keywords": [
    "Timer",
    "timers",
    "javascript"
  ],
  "author": {
    "name": "George Raptis",
    "email": "georapbox@gmail.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/georapbox/Timer/issues"
  },
  "homepage": "https://github.com/georapbox/Timer#readme",
  "devDependencies": {
    "@eslint/js": "~9.38.0",
    "@esm-bundle/chai": "~4.3.4-fix.0",
    "@open-wc/testing": "~4.0.0",
    "@web/dev-server": "~0.4.6",
    "@web/test-runner": "~0.20.2",
    "@web/test-runner-playwright": "~0.11.1",
    "esbuild": "~0.25.11",
    "eslint": "~9.38.0",
    "globals": "~16.4.0",
    "npm-run-all": "~4.1.5",
    "prettier": "~3.6.2",
    "rimraf": "~6.0.1",
    "sinon": "~21.0.0",
    "typescript": "~5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
